<aside class="cookie-consent" id="cookie-consent" hidden aria-label="Pengaturan privasi" aria-live="polite">
  <div><strong>Privasi & pengukuran</strong><p>Kami menggunakan Meta Pixel untuk memahami performa iklan. Pixel hanya dimuat setelah kamu menyetujuinya. <a href="/privacy">Pelajari kebijakan privasi</a>.</p></div>
  <div class="cookie-actions"><button type="button" data-consent="rejected">Tolak</button><button class="cookie-accept" type="button" data-consent="accepted">Setuju</button></div>
</aside>

<script>
  const consent = document.querySelector<HTMLElement>('#cookie-consent');
  const storedConsent = localStorage.getItem('khuncode_cookie_consent');
  if (consent && !storedConsent) consent.hidden = false;
  consent?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach(button => {
    button.addEventListener('click', () => {
      const choice = button.dataset.consent;
      if (!choice) return;
      localStorage.setItem('khuncode_cookie_consent', choice);
      consent.hidden = true;
      if (choice === 'accepted') {
        (window as Window & { khuncodeStartMetaPixel?: () => void }).khuncodeStartMetaPixel?.();
      }
    });
  });
</script>

<style>
  .cookie-consent { position: fixed; z-index: 80; left: 50%; bottom: 18px; transform: translateX(-50%); display: flex; align-items: center; justify-content: space-between; gap: 24px; width: min(760px,calc(100% - 32px)); padding: 18px 20px; border: 1px solid #d5def0; border-radius: 16px; background: #fff; box-shadow: 0 14px 45px #10182824; }
  .cookie-consent[hidden] { display: none; }.cookie-consent strong { font-size: 13px; }.cookie-consent p { margin-top: 5px; color: #5d6472; font-size: 11px; line-height: 1.7; }.cookie-consent a { color: #104ee8; text-decoration: underline; text-underline-offset: 3px; }
  .cookie-actions { display: flex; gap: 8px; flex-shrink: 0; }.cookie-actions button { min-height: 38px; padding: 9px 14px; border: 1px solid #c8d1e0; border-radius: 999px; background: #fff; font: inherit; font-size: 11px; font-weight: 600; cursor: pointer; }.cookie-actions .cookie-accept { border-color: #104ee8; background: #104ee8; color: #fff; }
  @media(max-width:600px) { .cookie-consent { align-items: stretch; flex-direction: column; gap: 14px; bottom: 10px; }.cookie-actions button { flex: 1; } }
</style>
