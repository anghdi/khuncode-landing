---
interface Props {
  message?: string;
  location?: string;
}

const { 
  message = `Halo KhunCode, saya tertarik membuat website toko online.

Nama bisnis:
Produk yang dijual:
Jumlah produk:
Sistem pesanan: WhatsApp / checkout
Target website selesai:

Saya ingin konsultasi paket yang cocok.`,
  location = "floating"
} = Astro.props;

const waUrl = `https://wa.me/6285117304509?text=${encodeURIComponent(message)}`;
---

<a
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  data-track-cta="whatsapp"
  data-location={location}
  class="fixed bottom-4 right-4 sm:bottom-6 sm:right-6 z-50 group flex items-center gap-2 px-3.5 py-3 sm:px-4 sm:py-3 bg-[#104ee8] hover:bg-[#0c3cbb] text-white rounded-full shadow-lg border border-white/20 transition-all duration-200 "
  aria-label="Tanya paket via WhatsApp"
>


  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.705 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-1.157 4.228 4.26-1.111z"/>
  </svg>

  <span class="inline-block font-semibold text-[10px] sm:text-xs tracking-wide whitespace-nowrap">
    Tanya paket
  </span>
</a>

