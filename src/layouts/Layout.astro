---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  campaign?: boolean;
  referenceHome?: boolean;
  structuredData?: Record<string, unknown>;
}

const {
  title = "KhunCode — Website untuk Brand & Bisnis",
  description = "KhunCode membantu brand dan bisnis membuat website e-commerce, business website, ticketing, booking, dan custom website.",
  campaign = false,
  referenceHome = false,
  structuredData,
  ogImage = "/logo.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://khuncode.com');
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#104ee8" />

    <!-- Google Fonts: Playfair Display + Plus Jakarta Sans + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />
    <meta property="og:locale" content="id_ID" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL)} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}

    <!-- Meta Pixel loads only after explicit consent. -->
    <script is:inline>
      window.khuncodeStartMetaPixel = function () {
        if (window.fbq) return;
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}
        (window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', '1935478463781174');
        window.fbq('track', 'PageView');
      };
      try { if (localStorage.getItem('khuncode_cookie_consent') === 'accepted') window.khuncodeStartMetaPixel(); } catch {}
    </script>

  </head>
  <body class:list={{ "campaign-page": campaign, "reference-home-page": referenceHome }}>
    <a class="skip-link" href="#main-content">Langsung ke konten</a>
    <div class="site-shell">
      <Header campaign={campaign} />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
    {!campaign && <WhatsAppButton />}
    <CookieConsent />
    <script>
      import '../scripts/lead-tracking';

      const motion = matchMedia('(prefers-reduced-motion: reduce)');
      if (!motion.matches && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver(entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('reveal-pending');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        document.querySelectorAll('[data-reveal]').forEach(element => {
          if (element.getBoundingClientRect().top > window.innerHeight) {
            element.classList.add('reveal-pending');
            observer.observe(element);
          }
        });
        motion.addEventListener('change', () => {
          if (motion.matches) {
            observer.disconnect();
            document.querySelectorAll('.reveal-pending').forEach(element => element.classList.remove('reveal-pending'));
          }
        });
      }
    </script>
  </body>
</html>

