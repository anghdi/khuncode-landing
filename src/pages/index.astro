---
import Layout from '../layouts/Layout.astro';
import PackagePricing from '../components/PackagePricing.astro';
import StorefrontShowcase from '../components/StorefrontShowcase.astro';
import { createWhatsAppUrl } from '../data/whatsapp';
import '../styles/reference-home.css';
const contact = createWhatsAppUrl();
const projects = [
  { name: 'Rhodes Apparel', category: 'Fashion e-commerce', screenshot: '/project-rhodes.webp', domain: 'rhodesapparel.id', description: 'Katalog produk, pilihan varian, dan pemesanan melalui WhatsApp.' },
  { name: 'Georgios Women', category: 'Fashion e-commerce', screenshot: '/project-georgios.webp', domain: 'georgioswomen.com', description: 'Koleksi produk dengan pencarian, shopping bag, dan pemesanan.' },
  { name: 'The Gratitude Show', category: 'Event ticketing', screenshot: '/project-gratitude.webp', domain: 'thegratitudeshow.com', description: 'Informasi acara, jadwal pertunjukan, dan pembelian tiket.' },
];
const faqs = [
  { question: 'Berapa lama proses pengerjaannya?', answer: 'Waktu pengerjaan mengikuti jumlah halaman, produk, fitur, serta kesiapan materi dari client. Estimasi jadwal disepakati setelah kebutuhan dipetakan.' },
  { question: 'Apakah harga sudah termasuk domain?', answer: 'Belum. Domain dibayar terpisah sesuai nama dan ekstensi yang dipilih. Deploy dan maintenance tersedia Rp100.000 per bulan.' },
  { question: 'Apa yang perlu saya siapkan?', answer: 'Siapkan logo, informasi bisnis, foto dan data produk, harga, serta referensi tampilan jika ada. Kami membantu menyusun struktur websitenya.' },
  { question: 'Apakah produk bisa ditambah sendiri?', answer: 'Pada paket Online Store dan Custom Commerce, pengelolaan produk dapat dilakukan melalui admin. Starter Store mencakup setup awal maksimal 10 produk.' },
  { question: 'Bagaimana jika belum tahu paket yang cocok?', answer: 'Ceritakan cara bisnis menerima pesanan dan jumlah produknya. Kami akan membantu memilih paket tanpa kewajiban langsung membeli.' },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'ProfessionalService', '@id': 'https://khuncode.com/#business', name: 'KhunCode', url: 'https://khuncode.com/', email: 'hello@khuncode.com', telephone: '+6285117304509', areaServed: { '@type': 'Country', name: 'Indonesia' }, description: 'Jasa pembuatan toko online untuk brand dan UMKM, mulai dari katalog dengan WhatsApp hingga checkout dan commerce custom.' },
    { '@type': 'Service', '@id': 'https://khuncode.com/#service', name: 'Jasa Pembuatan Toko Online', provider: { '@id': 'https://khuncode.com/#business' }, areaServed: 'Indonesia', offers: { '@type': 'AggregateOffer', priceCurrency: 'IDR', lowPrice: '1500000', highPrice: '4000000', offerCount: '3' } },
    { '@type': 'FAQPage', mainEntity: faqs.map(faq => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) },
  ],
};
---
<Layout referenceHome title="Jasa Pembuatan Toko Online untuk Brand & UMKM | KhunCode" description="Jasa pembuatan toko online mulai Rp1,5 juta. Pilih katalog dengan order WhatsApp, online store dengan checkout, atau commerce custom." ogImage="/project-rhodes.webp" structuredData={structuredData}>
<div class="compact-landing reference-home">
  <section class="reference-hero wrap">
    <div class="reference-hero-copy">
      <p class="eyebrow hero-enter">WEBSITE E-COMMERCE UNTUK BRAND LOKAL</p>
      <h1 class="hero-enter">Produkmu layak tampil menarik.<br /><em>Belanjanya juga harus mudah.</em></h1>
      <p class="reference-description hero-enter"><strong>Bikin pelanggan lihat produk, harga, dan cara order tanpa harus tanya satu-satu lewat chat.</strong><span>Kami merancang toko online yang rapi, cepat, dan nyaman dipakai—mulai dari katalog dengan order WhatsApp sampai checkout langsung.</span></p>
      <p class="hero-offer hero-enter"><strong>Mulai Rp1,5 juta</strong><span>Konsultasi kebutuhan tanpa biaya · Tidak wajib langsung membeli</span></p>
      <div class="reference-actions hero-enter"><a class="button" href={contact} target="_blank" rel="noopener noreferrer" data-track-cta="whatsapp" data-location="homepage-hero">Konsultasi via WhatsApp <span aria-hidden="true">↗</span></a><a class="reference-secondary" href="#harga">Lihat paket &amp; harga</a></div>
    </div>
    <StorefrontShowcase />
  </section>



  <section id="portfolio" class="featured-work wrap" aria-labelledby="client-heading">
    <div class="featured-work-heading"><div><p class="eyebrow">PROJECT PILIHAN</p><h2 id="client-heading">Website yang sudah aktif dan digunakan.</h2></div><a class="text-link" href="/portfolio">Lihat semua project ↗</a></div>
    <div class="featured-work-grid">{projects.map(project => <article class="featured-project"><a class="featured-project-preview" href={`https://${project.domain}`} target="_blank" rel="noopener noreferrer" aria-label={`Buka website ${project.name}`}><img src={project.screenshot} alt={`Tampilan homepage ${project.name}`} width="1200" height="834" loading="lazy" decoding="async" /><span aria-hidden="true">↗</span></a><div class="featured-project-copy"><p>{project.category}</p><h3>{project.name}</h3><p>{project.description}</p><a href={`https://${project.domain}`} target="_blank" rel="noopener noreferrer">Kunjungi {project.domain} ↗</a></div></article>)}</div>
  </section>

  <section id="harga" class="section wrap compact-offers">
    <div class="section-heading"><div><p class="eyebrow">PAKET TOKO ONLINE</p><h2>Mulai dari cara kamu berjualan.</h2><p class="section-intro">Katalog dengan order WhatsApp, checkout langsung, atau alur khusus. Pilih yang paling sesuai dengan cara bisnismu menerima pesanan.</p></div><a class="text-link" href="/harga">Lihat paket &amp; harga ↗</a></div>
    <PackagePricing />
    <div class="compact-studio"><div id="tentang"><h3>Dibuat untuk brand kamu</h3><p>Kami tidak sekadar memasang template. Struktur, tampilan, dan alur belanja disusun mengikuti produk serta cara bisnismu menerima pesanan.</p></div><div id="proses"><h3>Dari obrolan sampai online</h3><p>Kita bahas kebutuhan, susun desain, bangun dan uji websitenya, lalu bantu sampai siap digunakan.</p><a class="text-link" href="/layanan">Lihat cara kami bekerja ↗</a></div></div>
  </section>

  <section class="section wrap homepage-faq" aria-labelledby="faq-heading">
    <div class="faq-intro"><p class="eyebrow">SEBELUM MULAI</p><h2 id="faq-heading">Pertanyaan yang sering ditanyakan.</h2><p>Informasi dasar agar kamu bisa menilai kecocokan layanan sebelum menghubungi kami.</p></div>
    <div class="faq-list">{faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
    <div class="faq-action"><div><strong>Masih ada yang ingin ditanyakan?</strong><span>Ceritakan kebutuhan bisnismu. Kami bantu menentukan paket yang sesuai.</span></div><a class="button" href={contact} target="_blank" rel="noopener noreferrer" data-track-cta="whatsapp" data-location="homepage-faq">Konsultasi via WhatsApp <span aria-hidden="true">↗</span></a></div>
  </section>

</div>
</Layout>
