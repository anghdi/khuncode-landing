---
import Layout from '../layouts/Layout.astro';
import PackagePricing from '../components/PackagePricing.astro';
import StorefrontShowcase from '../components/StorefrontShowcase.astro';
import '../styles/reference-home.css';
const wa = (message: string) => `https://wa.me/6285117304509?text=${encodeURIComponent(message)}`;
const contact = wa('Halo KhunCode, saya ingin mendiskusikan website untuk brand saya.');
const projects = [
  { name: 'Rhodes Apparel', category: 'Fashion E-Commerce', image: '/rhodes.jpeg', domain: 'rhodesapparel.id', tone: 'rhodes', description: 'Rumah online untuk koleksi dan karakter sebuah brand.' },
  { name: 'Georgios Women', category: 'Fashion E-Commerce', image: '/georgios.png', domain: 'georgioswomen.com', tone: 'georgios', description: 'Pengalaman belanja yang berangkat dari identitas brand.' },
  { name: 'The Gratitude Show', category: 'Event & Ticketing', image: '/thegratitudeshow.png', domain: 'thegratitudeshow.com', tone: 'gratitude', description: 'Informasi acara dan pemesanan tiket dalam satu tempat.' },
];
---
<Layout referenceHome>
<div class="compact-landing reference-home">
  <section class="reference-hero wrap">
    <div class="reference-hero-copy">
      <p class="eyebrow hero-enter">KHUNCODE / WEBSITES FOR COMMERCE</p>
      <h1 class="hero-enter">Brand kamu punya cerita.<br /><em>Beri tempat untuk tumbuh.</em></h1>
      <p class="reference-description hero-enter">Toko online yang terasa seperti brand kamu.<br class="desktop-break" /> Dari katalog WhatsApp sampai pengalaman belanja dengan checkout.</p>
      <div class="reference-actions hero-enter"><a class="button" href={contact} target="_blank" rel="noopener noreferrer">Diskusikan Project <span aria-hidden="true">↗</span></a><a class="reference-secondary" href="#harga">Lihat paket website</a></div>
    </div>
    <StorefrontShowcase />
  </section>



  <section id="portfolio" class="reference-clients wrap" aria-labelledby="client-heading">
    <h2 id="client-heading">Sudah menjadi bagian dari perjalanan mereka.</h2>
    <div class="reference-client-row">{projects.map(project => <a class={`reference-client-logo logo-${project.tone}`} href={`https://${project.domain}`} target="_blank" rel="noopener noreferrer" aria-label={`Lihat website ${project.name}`}><img src={project.image} alt={project.name} width="180" height="75" loading="lazy" decoding="async" /></a>)}</div>
    <a class="reference-portfolio-link" href="/portfolio">Lihat portfolio ↗</a>
  </section>

  <section id="harga" class="section wrap compact-offers">
    <div class="section-heading"><div><p class="eyebrow">PAKET WEBSITE</p><h2>Pilih yang pas untuk bisnismu.</h2></div><a class="text-link" href="/harga">Detail paket ↗</a></div>
    <PackagePricing />
    <div class="compact-studio"><div id="tentang"><h3>Tentang KhunCode</h3><p>Studio web untuk brand dan bisnis, dengan fokus e-commerce. Dibuat sesuai identitas kamu, nyaman di HP, dan dibantu sampai tayang.</p></div><div id="proses"><h3>Proses yang jelas</h3><p>Diskusi → Perencanaan & desain → Development & testing → Launch.</p><a class="text-link" href="/layanan">Kenali layanan kami ↗</a></div></div>
  </section>

  <section class="final-cta"><div class="wrap" data-reveal><p class="eyebrow">PUNYA IDE UNTUK WEBSITE?</p><h2>Punya project? <em>Mari diskusi.</em></h2><div class="final-cta-bottom"><p>Ceritakan bisnismu dan apa yang ingin kamu bangun.<br />Kita mulai dari sana.</p><a class="button button-light" href={contact} target="_blank" rel="noopener noreferrer" data-track-cta="whatsapp" data-location="final-cta">Mulai diskusi <span aria-hidden="true">↗</span></a></div></div></section>
</div>
</Layout>
