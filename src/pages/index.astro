---
import Layout from '../layouts/Layout.astro';
import PackagePricing from '../components/PackagePricing.astro';
import StorefrontShowcase from '../components/StorefrontShowcase.astro';
import '../styles/reference-home.css';
const wa = (message: string) => `https://wa.me/6285117304509?text=${encodeURIComponent(message)}`;
const contact = wa(`Halo KhunCode, saya tertarik membuat website toko online.

Nama bisnis:
Produk yang dijual:
Jumlah produk:
Sistem pesanan: WhatsApp / checkout
Target website selesai:

Saya ingin konsultasi paket yang cocok.`);
const projects = [
  { name: 'Rhodes Apparel', category: 'Fashion E-Commerce', image: '/rhodes.jpeg', domain: 'rhodesapparel.id', tone: 'rhodes', description: 'Rumah online untuk koleksi dan karakter sebuah brand.' },
  { name: 'Georgios Women', category: 'Fashion E-Commerce', image: '/georgios.png', domain: 'georgioswomen.com', tone: 'georgios', description: 'Pengalaman belanja yang berangkat dari identitas brand.' },
  { name: 'The Gratitude Show', category: 'Event & Ticketing', image: '/thegratitudeshow.png', domain: 'thegratitudeshow.com', tone: 'gratitude', description: 'Informasi acara dan pemesanan tiket dalam satu tempat.' },
];
const faqs = [
  { question: 'Berapa lama proses pengerjaannya?', answer: 'Waktu pengerjaan mengikuti jumlah halaman, produk, fitur, serta kesiapan materi dari client. Estimasi jadwal disepakati setelah kebutuhan dipetakan.' },
  { question: 'Apakah harga sudah termasuk domain?', answer: 'Belum. Domain dibayar terpisah sesuai nama dan ekstensi yang dipilih. Deploy dan maintenance tersedia Rp100.000 per bulan.' },
  { question: 'Apa yang perlu saya siapkan?', answer: 'Siapkan logo, informasi bisnis, foto dan data produk, harga, serta referensi tampilan jika ada. Kami membantu menyusun struktur websitenya.' },
  { question: 'Apakah produk bisa ditambah sendiri?', answer: 'Pada paket Online Store dan Custom Commerce, pengelolaan produk dapat dilakukan melalui admin. Starter Store mencakup setup awal maksimal 10 produk.' },
  { question: 'Bagaimana jika belum tahu paket yang cocok?', answer: 'Ceritakan cara bisnis menerima pesanan dan jumlah produknya. Kami akan membantu memilih paket tanpa kewajiban langsung membeli.' },
];
---
<Layout referenceHome>
<div class="compact-landing reference-home">
  <section class="reference-hero wrap">
    <div class="reference-hero-copy">
      <p class="eyebrow hero-enter">WEBSITE E-COMMERCE UNTUK BRAND LOKAL</p>
      <h1 class="hero-enter">Produkmu layak tampil menarik.<br /><em>Belanjanya juga harus mudah.</em></h1>
      <p class="reference-description hero-enter">Kami merancang toko online yang rapi, cepat, dan nyaman dipakai—<br class="desktop-break" />mulai dari katalog dengan order WhatsApp sampai checkout langsung.</p>
      <p class="hero-offer hero-enter"><strong>Paket mulai Rp1,5 juta</strong><span>Konsultasi kebutuhan tanpa biaya · Tidak wajib langsung membeli</span></p>
      <div class="reference-actions hero-enter"><a class="button" href={contact} target="_blank" rel="noopener noreferrer" data-track-cta="whatsapp" data-location="homepage-hero">Konsultasi paket via WhatsApp <span aria-hidden="true">↗</span></a><a class="reference-secondary" href="#harga">Lihat paket &amp; harga</a></div>
    </div>
    <StorefrontShowcase />
  </section>



  <section id="portfolio" class="reference-clients wrap" aria-labelledby="client-heading">
    <h2 id="client-heading">Dipercaya membangun website untuk brand dan event yang sudah aktif.</h2>
    <div class="reference-client-row">{projects.map(project => <a class={`reference-client-logo logo-${project.tone}`} href={`https://${project.domain}`} target="_blank" rel="noopener noreferrer" aria-label={`Lihat website ${project.name}`}><img src={project.image} alt={project.name} width="180" height="75" loading="lazy" decoding="async" /></a>)}</div>
    <a class="reference-portfolio-link" href="/portfolio">Lihat project selengkapnya ↗</a>
  </section>

  <section id="harga" class="section wrap compact-offers">
    <div class="section-heading"><div><p class="eyebrow">PAKET TOKO ONLINE</p><h2>Mulai dari cara kamu berjualan.</h2><p class="section-intro">Butuh katalog sederhana atau checkout lengkap? Pilih fondasinya dulu, lalu desain kami sesuaikan dengan brand kamu.</p></div><a class="text-link" href="/harga">Bandingkan semua fitur ↗</a></div>
    <PackagePricing />
    <div class="compact-studio"><div id="tentang"><h3>Dibuat untuk brand kamu</h3><p>Kami tidak sekadar memasang template. Struktur, tampilan, dan alur belanja disusun mengikuti produk serta cara bisnismu menerima pesanan.</p></div><div id="proses"><h3>Dari obrolan sampai online</h3><p>Kita bahas kebutuhan, susun desain, bangun dan uji websitenya, lalu bantu sampai siap digunakan.</p><a class="text-link" href="/layanan">Lihat cara kami bekerja ↗</a></div></div>
  </section>

  <section class="section wrap homepage-faq" aria-labelledby="faq-heading">
    <div class="faq-intro"><p class="eyebrow">SEBELUM MULAI</p><h2 id="faq-heading">Pertanyaan yang sering ditanyakan.</h2><p>Informasi dasar agar kamu bisa menilai kecocokan layanan sebelum menghubungi kami.</p></div>
    <div class="faq-list">{faqs.map((faq, index) => <details open={index === 0}><summary>{faq.question}<span aria-hidden="true">+</span></summary><p>{faq.answer}</p></details>)}</div>
    <div class="faq-action"><div><strong>Masih ada yang ingin ditanyakan?</strong><span>Ceritakan kebutuhan bisnismu. Kami bantu menentukan paket yang sesuai.</span></div><a class="button" href={contact} target="_blank" rel="noopener noreferrer" data-track-cta="whatsapp" data-location="homepage-faq">Konsultasi via WhatsApp <span aria-hidden="true">↗</span></a></div>
  </section>

</div>
</Layout>
