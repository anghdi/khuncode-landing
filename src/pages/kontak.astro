---
import Layout from '../layouts/Layout.astro';
import { createWhatsAppUrl } from '../data/whatsapp';
const contact = createWhatsAppUrl();
---
<Layout title="Diskusikan Project Website — KhunCode" description="Ceritakan kebutuhan website bisnismu. Mulai diskusi dengan KhunCode melalui WhatsApp atau email.">
  <section class="section wrap inner-page"><header class="page-heading"><p class="eyebrow">MARI MULAI DARI OBROLAN</p><h1>Punya ide website?<br /><em>Ceritakan ke kami.</em></h1><p>Belum perlu brief yang lengkap. Mulai dari bisnis kamu, tujuan website, dan hal yang ingin kamu permudah.</p></header>
  <div class="contact-layout"><div class="contact-options"><a href={contact} target="_blank" rel="noopener noreferrer" data-track-cta="whatsapp" data-location="contact-direct"><span class="eyebrow">WHATSAPP</span><h2>Mulai obrolan langsung ↗</h2><p>+62 851-1730-4509</p></a><a href="mailto:hello@khuncode.com"><span class="eyebrow">EMAIL</span><h2>Kirim brief project ↗</h2><p>hello@khuncode.com</p></a><div class="contact-guidance"><h2>Apa yang bisa diceritakan?</h2><p>Jenis bisnis, produk atau layanan kamu, fitur yang diperlukan, serta referensi website jika ada.</p><a class="text-link" href="/harga">Lihat estimasi harga ↗</a></div></div>
  <div class="inquiry-panel"><h2>Siapkan pesan pertamamu.</h2><p>Isi beberapa informasi penting agar konsultasi lebih cepat dan tepat.</p><form id="wa-inquiry-form" hidden><div class="form-field"><label for="input-name">Nama bisnis / brand <span>(wajib)</span></label><input id="input-name" name="brand" autocomplete="organization" required maxlength="120" placeholder="Contoh: Daily Goods" /></div><div class="form-grid"><div class="form-field"><label for="input-product">Produk yang dijual</label><input id="input-product" name="product" maxlength="120" placeholder="Contoh: pakaian wanita" /></div><div class="form-field"><label for="input-count">Jumlah produk</label><input id="input-count" name="productCount" inputmode="numeric" maxlength="20" placeholder="Contoh: 25" /></div><div class="form-field"><label for="input-order">Sistem pesanan</label><select id="input-order" name="orderFlow"><option>Belum yakin</option><option>Order via WhatsApp</option><option>Cart dan checkout</option><option>Butuh alur khusus</option></select></div><div class="form-field"><label for="input-target">Target selesai</label><input id="input-target" name="target" maxlength="80" placeholder="Contoh: November 2026" /></div></div><div class="form-field"><label for="input-service">Paket yang diminati</label><select id="input-service" name="service"><option>Belum yakin, ingin diskusi dulu</option><option>Starter Store — Rp1.500.000</option><option>Online Store — Rp2.500.000</option><option>Custom Commerce — mulai Rp4.000.000</option></select></div><div class="form-field"><label for="input-notes">Kebutuhan tambahan <span>(opsional)</span></label><textarea id="input-notes" name="notes" rows="4" maxlength="1500" placeholder="Contoh: perlu variasi ukuran dan warna, atau referensi website yang disukai."></textarea></div><button class="button" type="submit">Siapkan pesan WhatsApp <span aria-hidden="true">↗</span></button><p class="form-note">Pesan bisa kamu periksa sebelum dikirim. Form ini tidak menyimpan data ke server KhunCode.</p></form><noscript><p><a class="text-link" href={contact}>Buka WhatsApp langsung ↗</a></p></noscript></div></div>
  </section>
  <script>
    import { createWhatsAppUrl } from '../data/whatsapp';
    const form = document.querySelector<HTMLFormElement>('#wa-inquiry-form');
    if (form) {
      form.hidden = false;
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const name = document.querySelector<HTMLInputElement>('#input-name')!.value.trim();
        const product = document.querySelector<HTMLInputElement>('#input-product')!.value.trim();
        const productCount = document.querySelector<HTMLInputElement>('#input-count')!.value.trim();
        const orderFlow = document.querySelector<HTMLSelectElement>('#input-order')!.value;
        const target = document.querySelector<HTMLInputElement>('#input-target')!.value.trim();
        const service = document.querySelector<HTMLSelectElement>('#input-service')!.value;
        const notes = document.querySelector<HTMLTextAreaElement>('#input-notes')!.value.trim();
        if (!name) { document.querySelector<HTMLInputElement>('#input-name')?.focus(); return; }
        const text = `Halo KhunCode, saya ingin konsultasi website toko online.\n\nNama bisnis: ${name}\nProduk yang dijual: ${product || '-'}\nJumlah produk: ${productCount || '-'}\nSistem pesanan: ${orderFlow}\nPaket yang diminati: ${service}\nTarget selesai: ${target || '-'}\n\nKebutuhan tambahan:\n${notes || '-'}`;
        window.location.assign(createWhatsAppUrl(text));
      });
    }
  </script>
</Layout>

