---
import Layout from '../layouts/Layout.astro';

const waNumber = "6285117304509";
const waBaseUrl = `https://wa.me/${waNumber}`;

const servicesDetail = [
  {
    id: "ecommerce",
    title: "E-Commerce Website",
    badge: "Fokus Utama Studio",
    subtitle: "Untuk brand yang ingin memiliki toko online sendiri secara mandiri.",
    description: "Website e-commerce memberikan akses penuh bagi brand untuk mengelola katalog produk, harga, dan proses pemesanan langsung.",
    includes: [
      "Halaman utama",
      "Katalog produk",
      "Detail produk",
      "Kategori produk",
      "Keranjang belanja",
      "Checkout sederhana",
      "Tombol WhatsApp",
      "Tampilan mobile",
      "Basic SEO",
      "Deployment ke hosting"
    ],
    waMsg: "Halo KhunCode, saya tertarik untuk mendiskusikan pembuatan E-Commerce Website toko online.",
    cta: "Diskusikan E-Commerce"
  },
  {
    id: "business",
    title: "Business Website",
    badge: "Media Kredibilitas",
    subtitle: "Untuk bisnis yang membutuhkan website profesional sebagai media informasi dan membangun kepercayaan.",
    description: "Tingkatkan reputasi dan rasa percaya calon klien/customer dengan memiliki profil bisnis resmi yang rapi, cepat, dan mudah diakses.",
    includes: [
      "Halaman utama",
      "Profil bisnis",
      "Layanan",
      "Portfolio",
      "Kontak",
      "Tombol WhatsApp",
      "Tampilan mobile",
      "Basic SEO",
      "Deployment ke hosting"
    ],
    waMsg: "Halo KhunCode, saya ingin mendiskusikan pembuatan Business Website.",
    cta: "Diskusikan Business Website"
  },
  {
    id: "booking",
    title: "Booking & Ticketing",
    badge: "Reservasi Event",
    subtitle: "Untuk bisnis atau event yang membutuhkan sistem booking, reservasi, atau penjualan tiket.",
    description: "Memudahkan pengunjung melakukan pemesanan tiket acara, reservasi tempat, atau jadwal konsultasi secara praktis.",
    includes: [
      "Halaman detail event / layanan",
      "Form reservasi / jadwal",
      "Sistem pemesanan tiket",
      "Alur konfirmasi sesuai kebutuhan",
      "Optimasi tampilan mobile",
      "Fitur disesuaikan kebutuhan"
    ],
    waMsg: "Halo KhunCode, saya berminat membuat sistem Booking & Ticketing.",
    cta: "Diskusikan Booking & Ticketing"
  },
  {
    id: "custom",
    title: "Custom Website",
    badge: "Sesuai Kebutuhan",
    subtitle: "Untuk kebutuhan website dengan fitur atau alur yang lebih spesifik.",
    description: "Solusi untuk bisnis dengan alur operasional khusus atau kebutuhan tampilan khusus.",
    includes: [
      "Diskusi alur bisnis mendalam",
      "Desain UI/UX custom brand",
      "Fitur & alur khusus",
      "Performa & kecepatan tinggi",
      "Penyesuaian hosting",
      "Publikasi ke hosting"
    ],
    waMsg: "Halo KhunCode, saya ingin menceritakan kebutuhan Custom Website spesifik.",
    cta: "Ceritakan Kebutuhanmu"
  }
];
---

<Layout title="Layanan Web Development — KhunCode" description="Pembuatan website e-commerce, business website, booking, ticketing, dan custom sesuai kebutuhan bisnis.">
  <section class="section wrap inner-page">
    <header class="page-heading"><p class="eyebrow">LAYANAN KHUNCODE</p><h1>Website yang tepat<br /><em>untuk kebutuhanmu.</em></h1><p>Dari toko online sampai alur bisnis yang lebih spesifik. Kita tentukan halaman dan fitur yang memang kamu perlukan.</p></header>
    <nav class="service-jumps" aria-label="Pilih layanan">{servicesDetail.map(s => <a href={`#${s.id}`}>{s.title} ↓</a>)}</nav>
    <div class="service-details">{servicesDetail.map((s,i) => <article id={s.id} class="service-detail-panel"><div><p class="eyebrow">0{i+1} / {s.badge}</p><h2>{s.title}</h2><p class="detail-lead">{s.subtitle}</p><p>{s.description}</p><a class="button" href={`${waBaseUrl}?text=${encodeURIComponent(s.waMsg)}`} target="_blank" rel="noopener noreferrer">{s.cta} <span aria-hidden="true">↗</span></a></div><div class="feature-panel"><h3>Umumnya mencakup</h3><ul>{s.includes.map(item => <li>{item}</li>)}</ul></div></article>)}</div>
    <aside class="next-step"><div><h2>Ingin tahu estimasi biayanya?</h2><p>Lihat harga awal, lalu kita sesuaikan dengan lingkup project.</p></div><a class="text-link" href="/harga">Lihat harga ↗</a></aside>
  </section>
</Layout>
