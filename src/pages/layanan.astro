---
import Layout from '../layouts/Layout.astro';
import { packages } from '../data/packages';

const whatsappUrl = (plan: typeof packages[number]) =>
  `https://wa.me/6285117304509?text=${encodeURIComponent(
    `Halo KhunCode, saya tertarik paket ${plan.name} ${plan.starting ? 'mulai ' : ''}Rp${plan.price}. Saya ingin mendiskusikan kebutuhan toko online saya.`
  )}`;
---

<Layout title="Layanan Toko Online — KhunCode" description="Pilih Starter Store, Online Store, atau Custom Commerce sesuai cara customer berbelanja dan kebutuhan operasional bisnis kamu.">
  <section class="section wrap inner-page services-page">
    <header class="page-heading">
      <p class="eyebrow">LAYANAN COMMERCE KHUNCODE</p>
      <h1>Dari katalog sederhana<br /><em>sampai commerce custom.</em></h1>
      <p>Tiga paket untuk tahap bisnis yang berbeda. Mulai dari pemesanan WhatsApp, lanjut ke checkout langsung, hingga sistem yang mengikuti alur operasional brand kamu.</p>
    </header>

    <nav class="service-jumps" aria-label="Pilih paket toko online">
      {packages.map(plan => <a href={`#${plan.id}`}>{plan.name} ↓</a>)}
    </nav>

    <div class="service-details">
      {packages.map((plan, index) => (
        <article id={plan.id} class="service-detail-panel package-service-panel">
          <div class="service-package-copy">
            <p class="eyebrow">0{index + 1} / {plan.kicker}</p>
            <h2>{plan.name}</h2>
            <p class="detail-lead">{plan.audience}</p>
            <p>{plan.description}</p>
            <div class="service-package-price"><span>{plan.starting ? 'Mulai dari' : 'Biaya pembuatan'}</span><strong>Rp{plan.price}</strong></div>
            <ul class="service-package-summary"><li>{plan.capacity}</li><li>{plan.revision}</li><li>{plan.highlight}</li></ul>
            <a class="button" href={whatsappUrl(plan)} target="_blank" rel="noopener noreferrer">Diskusikan {plan.name} <span aria-hidden="true">↗</span></a>
          </div>
          <div class="feature-panel">
            <h3>Yang termasuk dalam paket</h3>
            <p class="service-scope-note">{plan.scopeNote}</p>
            <ul>{plan.features.map(feature => <li>{feature}</li>)}</ul>
          </div>
        </article>
      ))}
    </div>

    <aside class="package-costs services-costs" aria-label="Biaya tambahan untuk semua paket"><p><strong>Deploy + maintenance</strong><span>Rp100.000/bulan untuk semua paket.</span></p><p><strong>Domain</strong><span>Dibayar terpisah sesuai domain yang dipilih client.</span></p></aside>
    <aside class="next-step"><div><h2>Masih bingung memilih paket?</h2><p>Ceritakan jumlah produk dan alur pemesanan yang kamu inginkan. Kami bantu menentukan paketnya.</p></div><a class="text-link" href="/kontak">Diskusi dulu ↗</a></aside>
  </section>
</Layout>
